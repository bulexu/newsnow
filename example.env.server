G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=
TIANAPI_KEY=
# CloakBrowser CDP 地址，用于绕过 Cloudflare 反爬保护
# 本地开发: http://localhost:9222  Docker 部署: http://cloakbrowser:9222
CLOAKBROWSER_CDP_URL=
# robots.txt 遵从策略: strict | off
ROBOTS_TXT_POLICY=strict
# 用于 robots.txt 匹配的 User-Agent，留空则沿用请求头里的 User-Agent
ROBOTS_TXT_USER_AGENT=
# robots.txt 规则缓存时间，默认 12 小时
ROBOTS_TXT_CACHE_TTL_MS=43200000
{
  "name": "newsnow",
  "type": "module",
  "version": "0.0.41",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "nitro-go>h3": "npm:h3-nightly@1.15.4-20250730-094032-325a62b",
      "vite-plugin-with-nitro>h3": "npm:h3-nightly@1.15.4-20250730-094032-325a62b",
      "esbuild": "0.25.10"
    }
  },
  "author": {
    "url": "https://github.com/ourongxing/",
    "email": "orongxing@gmail.com",
    "name": "ourongxing"
  },
  "homepage": "https://github.com/ourongxing/newsnow",
  "scripts": {
    "dev": "npm run presource && cross-env NODE_OPTIONS=--use-env-proxy vite dev",
    "build": "npm run presource && vite build",
    "lint": "eslint",
    "presource": "tsx ./scripts/favicon.ts && tsx ./scripts/source.ts",
    "start": "node --env-file .env.server dist/output/server/index.mjs",
    "preview": "cross-env CF_PAGES=1 npm run build && wrangler pages dev dist/output/public",
    "deploy": "cross-env CF_PAGES=1 npm run build && wrangler pages deploy dist/output/public",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.app.json",
    "release": "bumpp",
    "prepare": "simple-git-hooks",
    "log": "wrangler pages deployment tail --project-name newsnow",
    "test": "vitest -c vitest.config.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.2.0",
    "@formkit/auto-animate": "^0.8.4",
    "@iconify-json/si": "^1.2.17",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@types/turndown": "^5.0.6",
    "@unocss/reset": "^66.10.0",
    "ahooks": "^3.10.0",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "cookie-es": "^2.0.1",
    "dayjs": "1.11.13",
    "db0": "^0.3.4",
    "defu": "^6.1.7",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^12.43.0",
    "h3": "^1.15.11",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.12",
    "jotai": "^2.20.3",
    "md5": "^2.3.0",
    "ofetch": "^1.5.1",
    "overlayscrollbars": "^2.16.0",
    "playwright-core": "^1.63.0",
    "pnpm": "^10.34.5",
    "react": "^19.2.8",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.8",
    "react-use": "^17.6.1",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "uncrypto": "^0.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@iconify-json/ph": "^1.2.2",
    "@napi-rs/pinyin": "^1.7.7",
    "@ourongxing/eslint-config": "3.2.3-beta.6",
    "@rollup/pluginutils": "^5.4.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/md5": "^2.3.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@unocss/rule-utils": "^66.10.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "bumpp": "^10.4.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-glob": "^3.3.3",
    "favicons-scraper": "^1.3.2",
    "lint-staged": "^16.4.0",
    "mlly": "^1.8.2",
    "mockdate": "^3.0.5",
    "pnpm-patch-i": "^0.5.6",
    "rollup": "^4.63.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "unimport": "^6.4.0",
    "unocss": "^66.10.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-with-nitro": "^0.0.5",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "4.14.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
